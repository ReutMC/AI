{
  "device": "cpu",
  "torch_threads": 2,
  "max_seq_len": 192,
  "batch_size": 1,
  "gradient_accumulation": 8,
  "dtype": "bfloat16",
  "use_gradient_checkpointing": false,
  "lora_r": 12,
  "lora_alpha": 24,
  "lora_dropout": 0.05,
  "lora_targets": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "learning_rate": 0.00012,
  "weight_decay": 0.01,
  "warmup_ratio": 0.06,
  "lr_scheduler": "cosine",
  "max_grad_norm": 1.0,
  "max_train_minutes": 170,
  "eval_every_steps": 40,
  "log_every_steps": 5,
  "seed": 42,
  "deterministic": true
}