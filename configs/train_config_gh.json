{
  "device": "cpu",
  "torch_threads": 4,
  "max_seq_len": 1024,
  "batch_size": 1,
  "gradient_accumulation": 8,
  "dtype": "bfloat16",
  "use_gradient_checkpointing": false,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_targets": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "learning_rate": 0.0001,
  "weight_decay": 0.01,
  "warmup_ratio": 0.05,
  "lr_scheduler": "cosine",
  "max_grad_norm": 1.0,
  "max_train_minutes": 290,
  "eval_every_steps": 60,
  "log_every_steps": 10,
  "seed": 42,
  "deterministic": true,
  "max_epochs": 4
}
